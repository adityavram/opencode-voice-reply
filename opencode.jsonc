{
  "$schema": "https://opencode.ai/config.json",
  "command": {
    "voice": {
      "template": "voice {{args}}",
      "description": "Toggle or set voice reply on/off (e.g. /voice on, /voice off, /voice)"
    },
    "ping": {
      "template": "ping {{args}}",
      "description": "Toggle phone ping on/off, or set mode: /ping sms, /ping call, /ping escalate, /ping on, /ping off"
    }
  }
}